    "version": "0.2.0",
    "configurations": [

        {
            "name": "Prediction",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--experiment_type", "supervised_learning",
                "--model_type", "xgbregressor", 
                "--prediction_type", "discharge_mortality",
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "quick_test",
                "--search_variant", "random_search",
                "--n_search_iterations", "2"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Mortality Prediction - CHOC - xgbregressor",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--experiment_type", "supervised_learning",
                "--model_type", "xgbregressor", 
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "standard",
                "--search_variant", "random_search",
                "--n_search_iterations", "50"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Prediction aggregate - CHOC - SHAP",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbclassifier", 
                "--mode", "aggregate", 

                "--experiment_folder", 
                "xgbclassifier_discharge_mortality_choc_grid_search/20250814_015942",
                
                "--prediction_type", "discharge_mortality",
                "--calculate_shap", "true", 
                "--shap_max_samples", "5000",          
                "--shap_background_samples", "1000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Prediction aggregate - CHOC - module",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbregressor", 
                "--mode", "aggregate", 
                "--experiment_folder", "choc_discharge_mortality_xgbregressor_random_search_standard_20250816_004623",
                "--prediction_type", "discharge_mortality"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }, 

        {
            "name": "combine aggregates",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbregressor", 
                "--mode", "combine_aggregates", 
                "--experiment_dir", "xgbregressor_mortality_prediction_choc_grid_search"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }


    ]
}