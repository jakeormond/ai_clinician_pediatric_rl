    "version": "0.2.0",
    "configurations": [

        {
            "name": "Mortality Prediction - CHOC - xgbclassifier",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbclassifier", 
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "quick_test"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Mortality Prediction - CHOC - xgbregressor",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--experiment_type", "supervised_learning",
                "--model_type", "xgbregressor", 
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "standard",
                "--search_variant", "random_search",
                "--n_search_iterations", "50"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Mortality Prediction aggregate - CHOC - module",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbregressor", 
                "--mode", "aggregate", 
                "--experiment_folder", "choc_supervised_learning_xgbregressor_standard_20250808_222415"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }, 

        {
            "name": "combine aggregates",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbregressor", 
                "--mode", "combine_aggregates", 
                "--experiment_dir", "xgbregressor_mortality_prediction_choc_grid_search"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }


    ]
}