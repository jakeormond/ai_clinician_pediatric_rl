    "version": "0.2.0",
    "configurations": [

        {
            "name": "save_dataframe",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--experiment_type", "supervised_learning",
                "--mode", "save_dataframe"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },
        
        {
            "name": "Prediction",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--experiment_type", "supervised_learning",
                "--model_type", "xgbregressor", 
                "--prediction_type", "discharge_mortality",
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "quick_test",
                "--search_variant", "random_search",
                "--n_search_iterations", "2"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "reinforcement_learning",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.rl.any_percent_bc",
            "args": [
                "--hospital", "choc", 
                "--experiment_type", "reinforcement_learning",
                "--model_type", "any_percent_bc", 
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "quick_test",
                "--search_variant", "random_search",
                "--n_search_iterations", "2",
                "--testing", "true"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Prediction aggregate - CHOC - SHAP",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbclassifier", 
                "--mode", "aggregate", 

                "--experiment_folder", 
                "xgbclassifier_discharge_mortality_choc_grid_search/20250814_185430",
                
                "--prediction_type", "discharge_mortality",
                "--calculate_shap", "true", 
                "--shap_max_samples", "5000",          
                "--shap_background_samples", "1000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Plot model results - CHOC",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbclassifier", 
                "--mode", "plot_model_results", 

                "--experiment_folder", 
                "xgbclassifier_discharge_mortality_choc_grid_search/20250814_185430",
                
                "--prediction_type", "discharge_mortality",

            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Plot SHAP - CHOC",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgbclassifier", 
                "--mode", "plot_shap", 

                "--experiment_folder", 
                "xgbclassifier_discharge_mortality_choc_grid_search/20250814_185430",
                
                "--prediction_type", "discharge_mortality",
                "--calculate_shap", "true", 
                "--shap_max_samples", "5000",          
                "--shap_background_samples", "1000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
