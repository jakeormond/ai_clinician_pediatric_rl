    "version": "0.2.0",
    "configurations": [

        {
            "name": "Mortality Prediction - CHOC - script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/scripts/supervised/supervised_learning.py",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgb", 
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "quick_test"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },

        {
            "name": "Mortality Prediction - CHOC - module",
            "type": "debugpy",
            "request": "launch",
            "module": "src.scripts.supervised.supervised_learning",
            "args": [
                "--hospital", "choc", 
                "--model_type", "xgb", 
                "--mode", "single_fold", 
                "--fold", "0",
                "--experiment_variant", "quick_test"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}