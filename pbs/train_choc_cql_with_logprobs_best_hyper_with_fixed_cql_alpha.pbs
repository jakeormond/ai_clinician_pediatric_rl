#!/bin/bash
# pbs/train_choc_cql_with_logprobs_single_split_best_hyper_with_fixed_cql_alpha.pbs

# Job name
#PBS -N cql_with_logprobs_best_hyper_with_fixed_cql_alpha

# Output and error files
#PBS -o /rds/general/user/jormond/home/projects/ai_clinician/code/ai_clinician_pediatric_rl/pbs/logs
#PBS -e /rds/general/user/jormond/home/projects/ai_clinician/code/ai_clinician_pediatric_rl/pbs/logs

# Resources: nodes, CPUs, memory
#PBS -l select=1:ncpus=1:mem=128gb:ngpus=1
#PBS -l walltime=24:00:00

# Email notifications
#PBS -m bea
#PBS -M j.ormond@imperial.ac.uk

# Exit on any error
set -e

# Generate a unique start time for this job
START_TIME=$(date +"%Y%m%d_%H%M%S")
export START_TIME

# Load modules
module load miniforge/3

# Set environment variables
export OMP_NUM_THREADS=1   # matches ncpus
export PYTHONUNBUFFERED=1  
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Navigate to project directory
cd /rds/general/user/jormond/home/projects/ai_clinician/code/ai_clinician_pediatric_rl

# Activate Conda environment
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate rl_env

# Print job information
echo "========================================="
echo "Job Information:"
echo "Job ID: $PBS_JOBID"
echo "Job Name: $PBS_JOBNAME"
echo "Node(s): $PBS_NODEFILE"
echo "CPUs allocated (NCPUS): ${NCPUS:-unknown}"
echo "CPUs per node (PBS_NUM_PPN): ${PBS_NUM_PPN:-unknown}"echo "Memory: 64GB"
echo "OMP_NUM_THREADS: ${OMP_NUM_THREADS:-unknown}"
echo "Start time: $(date)"
echo "Working directory: $(pwd)"
echo "Active conda environment: $CONDA_DEFAULT_ENV"
echo "Python version: $(python --version)"
echo "CUDA_VISIBLE_DEVICES = $CUDA_VISIBLE_DEVICES"
nvidia-smi
echo "========================================="

# Run the training script for this fold
echo "Starting training..."

python -u -m src.scripts.rl.reinforcement_learning \
    --hospital choc \
    --experiment_type reinforcement_learning \
    --model_type cql_with_logprobs \
    --reward_type health_score \
    --mode single_split \
    --split_num 0 \
    --search_variant best_hyperparameters_fixed_cql_alpha \
    --cql_alpha 0.022 \
    --seeds "0" "1" "2" "3" "4" \
    --n_epochs 400 \
    --action_mode continuous_only \
    --cohort sepsis \
    --unit PICU \
    --filter_old True \
    --reward_cohort picu \
    --include_actions_in_state False \
    --start_time $START_TIME 
    
exit_code=$?

echo "========================================="
echo "End time: $(date)"
if [ $exit_code -eq 0 ]; then
    echo "Training completed successfully!"
else
    echo "Training failed with exit code $exit_code"
    exit $exit_code
fi
echo "========================================="